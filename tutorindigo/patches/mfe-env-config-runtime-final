
['org.openedx.frontend.layout.footer.v1', 'org.openedx.frontend.layout.studio_footer.v1'].forEach((footerSlotId) => {
  if (!(config.pluginSlots && config.pluginSlots[footerSlotId])) {
    return;
  }
  const footerInserts = config.pluginSlots[footerSlotId].plugins.filter(
    (plugin) => plugin.op === 'insert' && plugin.widget?.id === 'indigo_footer',
  );
  if (footerInserts.length > 1) {
    let kept = false;
    config.pluginSlots[footerSlotId].plugins = config.pluginSlots[footerSlotId].plugins.filter((plugin) => {
      if (plugin.op === 'insert' && plugin.widget?.id === 'indigo_footer') {
        if (kept) return false;
        kept = true;
      }
      return true;
    });
  }
});
